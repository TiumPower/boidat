<%# viewer: "guardian" (PWA phụ huynh) hoặc "staff" (hộp thư admin) — tin của
    chính người đang xem thì căn phải. %>
<% viewer = local_assigns.fetch(:viewer, "guardian") %>
<% mine = message.sender_kind == viewer %>
<div style="display:flex; justify-content:<%= mine ? 'flex-end' : 'flex-start' %>; margin-bottom:8px;">
  <div style="max-width:78%; padding:9px 13px; border-radius:16px; font-size:13.5px; line-height:1.5;
              background:<%= mine ? 'var(--primary)' : '#fff' %>;
              color:<%= mine ? 'var(--on-primary)' : 'var(--ink)' %>;
              border:1px solid <%= mine ? 'transparent' : 'var(--line)' %>;">
    <% unless mine %>
      <div style="font-size:11px; opacity:.65; margin-bottom:2px;"><%= message.sender_name %></div>
    <% end %>
    <%= simple_format(message.body, {}, sanitize: true, wrapper_tag: "span") %>
    <div style="font-size:10.5px; opacity:.6; margin-top:3px; text-align:right;">
      <%= l(message.created_at, format: "%H:%M") %>
    </div>
  </div>
</div>
