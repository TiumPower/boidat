<% nav  = defined?(nav_key) ? nav_key : nil %>
<% area = request.path.start_with?("/merchant/bod") ? :bod : :ops %>
<aside class="l-side" data-controller="activenav">
  <div class="brand">
    <div class="logo"><%= current_workspace&.logo_initials || "BĐ" %></div>
    <div>
      <div class="nm"><%= current_workspace&.name || "BƠI ĐẠT" %></div>
      <div class="sub"><%= area == :bod ? "Cổng điều hành" : "Cổng vận hành" %></div>
    </div>
  </div>

  <%# Chuyển hồ đang làm việc (FR-201) — nhớ giữa các phiên. Cổng điều hành nhìn
      toàn bộ hồ nên bộ chọn nằm trên dashboard, không nằm ở sidebar. %>
  <% if area == :ops && accessible_pools.size > 1 %>
    <details class="l-ws" <%= "open" if params[:pool_switcher] %>>
      <summary style="cursor:pointer; list-style:none;">
        <div class="k">Hồ đang chọn</div>
        <div class="v"><%= current_pool&.name %> ▾</div>
      </summary>
      <div style="margin-top:8px; display:flex; flex-direction:column; gap:4px;">
        <% accessible_pools.each do |pool| %>
          <%= button_to pool.name, merchant_switch_pool_path(pool), class: "l-nav-item",
                style: "background:none;border:none;text-align:left;width:100%;#{'font-weight:700;' if pool.id == current_pool&.id}" %>
        <% end %>
      </div>
    </details>
  <% elsif current_pool %>
    <div class="l-ws"><div class="k">Hồ đang chọn</div><div class="v"><%= current_pool.name %></div></div>
  <% end %>

  <% if area == :bod %>
    <div class="l-navgrp">Điều hành</div>
    <%= link_to merchant_bod_root_path, class: "l-nav-item #{'active' if nav == :dashboard}" do %>
      <span>▣</span><span>Bảng điều khiển</span>
    <% end %>
    <%= link_to merchant_bod_reports_path, class: "l-nav-item #{'active' if nav == :reports}" do %>
      <span>📈</span><span>Báo cáo &amp; xuất file</span>
    <% end %>

    <div class="l-navgrp">Quản trị</div>
    <%= link_to merchant_bod_pools_path, class: "l-nav-item #{'active' if nav == :pools}" do %>
      <span>🏊</span><span>Hồ bơi &amp; lịch hoạt động</span>
    <% end %>
    <%= link_to merchant_bod_staff_index_path, class: "l-nav-item #{'active' if nav == :staff}" do %>
      <span>👥</span><span>Nhân viên</span>
    <% end %>
    <%= link_to merchant_bod_teachers_path, class: "l-nav-item #{'active' if nav == :teachers}" do %>
      <span>🎓</span><span>Giáo viên</span>
    <% end %>
    <div class="l-navgrp">Sản phẩm</div>
    <%= link_to merchant_bod_courses_path, class: "l-nav-item #{'active' if nav == :courses}" do %>
      <span>📘</span><span>Khoá học &amp; giáo án</span>
    <% end %>
    <%= link_to merchant_bod_packages_path, class: "l-nav-item #{'active' if nav == :packages}" do %>
      <span>🏷</span><span>Gói &amp; bảng giá</span>
    <% end %>

    <div class="l-navgrp">Cấu hình</div>
    <%= link_to merchant_bod_settings_path, class: "l-nav-item #{'active' if nav == :settings}" do %>
      <span>⚙️</span><span>Cấu hình hệ thống</span>
    <% end %>
    <%= link_to merchant_bod_appearance_path, class: "l-nav-item #{'active' if nav == :appearance}" do %>
      <span>🎨</span><span>Màu chủ đạo</span>
    <% end %>
    <%= link_to merchant_bod_audit_logs_path, class: "l-nav-item #{'active' if nav == :audit}" do %>
      <span>🧾</span><span>Nhật ký thao tác</span>
    <% end %>
  <% else %>
    <div class="l-navgrp">Vận hành</div>
    <%= link_to merchant_ops_root_path, class: "l-nav-item #{'active' if nav == :schedule}" do %>
      <span>🗓</span><span>Lịch hồ bơi</span>
    <% end %>
    <%= link_to merchant_ops_students_path, class: "l-nav-item #{'active' if nav == :students}" do %>
      <span>🧒</span><span>Học viên &amp; gia đình</span>
    <% end %>
    <%= link_to merchant_ops_graduations_path, class: "l-nav-item #{'active' if nav == :graduations}" do %>
      <span>🏅</span><span>Thi tốt nghiệp</span>
    <% end %>
    <%= link_to merchant_ops_teachers_path, class: "l-nav-item #{'active' if nav == :teachers}" do %>
      <span>🎓</span><span>Giáo viên &amp; chấm công</span>
    <% end %>
    <%= link_to merchant_ops_timesheets_path, class: "l-nav-item #{'active' if nav == :timesheets}" do %>
      <span>💰</span><span>Bảng chấm công</span>
    <% end %>
    <%= link_to merchant_ops_day_passes_path, class: "l-nav-item #{'active' if nav == :day_passes}" do %>
      <span>🎟</span><span>Vé lẻ</span>
    <% end %>
    <%= link_to merchant_ops_packages_path, class: "l-nav-item #{'active' if nav == :packages}" do %>
      <span>🏷</span><span>Gói &amp; bảng giá</span>
    <% end %>
    <%= link_to merchant_ops_audit_logs_path, class: "l-nav-item #{'active' if nav == :audit}" do %>
      <span>🧾</span><span>Nhật ký thao tác</span>
    <% end %>
  <% end %>

  <div class="l-navgrp">Tài khoản</div>
  <% if current_membership&.executive? %>
    <%= link_to(area == :bod ? merchant_ops_root_path : merchant_bod_root_path, class: "l-nav-item") do %>
      <span>⇄</span><span><%= area == :bod ? "Sang cổng vận hành" : "Sang cổng điều hành" %></span>
    <% end %>
    <%= link_to merchant_billing_path, class: "l-nav-item #{'active' if nav == :billing}" do %>
      <span>◇</span><span>Gói &amp; thanh toán</span>
    <% end %>
  <% end %>

  <div class="foot">
    <%= link_to merchant_account_path, style: "display:flex; align-items:center; gap:10px; flex:1; min-width:0; text-decoration:none; color:inherit; border-radius:10px; padding:4px 6px; #{'background:rgba(255,255,255,.1);' if nav == :account}", title: "Hồ sơ của tôi" do %>
      <div class="av"><%= current_user&.initials %></div>
      <div style="min-width:0;">
        <div style="font-size:13px; font-weight:600;"><%= current_user&.name %></div>
        <div style="font-size:11px; opacity:.6;"><%= current_membership&.label %></div>
      </div>
    <% end %>
    <%= button_to "⎋", destroy_user_session_path, method: :delete,
          form: { data: { turbo_confirm: "Đăng xuất khỏi hệ thống?" } },
          style: "margin-left:auto;background:none;border:none;color:inherit;cursor:pointer;font-size:16px;" %>
  </div>
</aside>
