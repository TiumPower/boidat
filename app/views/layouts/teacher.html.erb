<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="pwa-app">
  <head>
    <% content_for :apple_title, "Giáo viên" %>
    <% content_for(:title) { "Cổng giáo viên" } unless content_for?(:title) %>
    <%= render "layouts/head" %>
    <link rel="manifest" href="<%= teacher_pwa_manifest_path %>">
    <% if current_workspace %>
      <meta name="theme-color" content="<%= current_workspace.theme_value(:primary) %>">
      <link rel="icon" href="<%= workspace_icon_url(current_workspace) %>">
      <link rel="apple-touch-icon" href="<%= workspace_icon_url(current_workspace) %>">
    <% end %>
  </head>
  <body class="pwa-app">
    <%= render "layouts/theme_vars", ws: current_workspace %>
    <div class="l-phone"
         data-controller="pwa"
         data-pwa-vapid-value="<%= PushSender.public_key %>"
         data-pwa-subscribe-url-value="<%= teacher_push_subscribe_path %>"
         data-pwa-unsubscribe-url-value="<%= teacher_push_unsubscribe_path %>"
         data-pwa-on-text="<%= t('customer.pwa.push_on') %>"
         data-pwa-off-text="<%= t('customer.pwa.push_off') %>"
         data-pwa-blocked-text="<%= t('customer.pwa.push_blocked') %>"
         data-pwa-unsupported-text="<%= t('customer.pwa.push_unsupported') %>">
      <%= yield %>
      <% unless content_for?(:no_tabbar) %>
        <%= render "layouts/teacher_tabbar" %>
      <% end %>
    </div>
  </body>
</html>
