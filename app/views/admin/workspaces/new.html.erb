<% content_for :title, "Tạo trung tâm mới" %>

<div class="l-panel" style="max-width:640px;">
  <%= form_with model: @workspace, url: admin_workspaces_path, data: { turbo: false } do |f| %>
    <% if @workspace.errors.any? %>
      <div class="l-chip" style="background:#FBECEC; color:#9B2C2C; margin-bottom:14px; display:block;">
        <%= @workspace.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="l-eyebrow" style="margin-bottom:10px;">Trung tâm</div>
    <div style="margin-bottom:12px;">
      <%= f.label :name, "Tên trung tâm", class: "l-label" %>
      <%= f.text_field :name, class: "l-field", placeholder: "BƠI ĐẠT" %>
    </div>
    <div style="margin-bottom:12px;">
      <%= f.label :subdomain, "Subdomain", class: "l-label" %>
      <%= f.text_field :subdomain, class: "l-field", placeholder: "boidat" %>
      <div style="font-size:12px; color:var(--ink-2); margin-top:4px;">
        PWA phụ huynh sẽ chạy tại <code>&lt;subdomain&gt;.<%= ApplicationController::PLATFORM_HOST %></code>
      </div>
    </div>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:18px;">
      <div>
        <%= f.label :plan, "Gói", class: "l-label" %>
        <%= f.select :plan, Plan::DEFAULTS.map { |p| [p[:name], p[:key]] }, {}, class: "l-field" %>
      </div>
      <div>
        <%= f.label :status, "Trạng thái", class: "l-label" %>
        <%= f.select :status, Workspace::STATUSES.map { |s| [Workspace::STATUS_LABELS[s], s] }, {}, class: "l-field" %>
      </div>
    </div>

    <div class="l-eyebrow" style="margin-bottom:10px;">Tài khoản BOD đầu tiên (FR-001)</div>
    <div style="margin-bottom:12px;">
      <%= label_tag :owner_name, "Họ tên", class: "l-label" %>
      <%= text_field_tag :owner_name, params[:owner_name], class: "l-field" %>
    </div>
    <div style="margin-bottom:12px;">
      <%= label_tag :owner_email, "Email đăng nhập", class: "l-label" %>
      <%= email_field_tag :owner_email, params[:owner_email], class: "l-field" %>
    </div>
    <div style="margin-bottom:18px;">
      <%= label_tag :owner_password, "Mật khẩu (để trống sẽ tự sinh)", class: "l-label" %>
      <%= text_field_tag :owner_password, nil, class: "l-field" %>
    </div>

    <%= f.submit "Tạo trung tâm", class: "l-btn l-btn-primary" %>
    <%= link_to "Huỷ", admin_workspaces_path, class: "l-btn l-btn-ghost" %>
  <% end %>
</div>
