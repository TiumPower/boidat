<% content_for :title, @workspace.name %>

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:14px; margin-bottom:18px;">
  <div class="l-kpi"><div class="k">Hồ bơi</div><div class="v"><%= @pools_count %></div></div>
  <div class="l-kpi"><div class="k">Học viên</div><div class="v"><%= @students_count %></div></div>
  <div class="l-kpi"><div class="k">Giáo viên</div><div class="v"><%= @teachers_count %></div></div>
  <div class="l-kpi"><div class="k">Nhân sự</div><div class="v"><%= @staff_count %></div></div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
  <div class="l-panel">
    <div style="font-weight:700; margin-bottom:12px;">Thông tin</div>
    <%= form_with model: @workspace, url: admin_workspace_path(@workspace), method: :patch, data: { turbo: false } do |f| %>
      <div style="margin-bottom:12px;"><%= f.label :name, "Tên", class: "l-label" %><%= f.text_field :name, class: "l-field" %></div>
      <div style="margin-bottom:12px;"><%= f.label :subdomain, "Subdomain", class: "l-label" %><%= f.text_field :subdomain, class: "l-field" %></div>
      <div style="margin-bottom:12px;"><%= f.label :custom_domain, "Tên miền riêng", class: "l-label" %><%= f.text_field :custom_domain, class: "l-field" %></div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:16px;">
        <div><%= f.label :plan, "Gói", class: "l-label" %><%= f.select :plan, Plan.ordered.map { |p| [p.name, p.key] }, {}, class: "l-field" %></div>
        <div><%= f.label :status, "Trạng thái", class: "l-label" %><%= f.select :status, Workspace::STATUSES.map { |s| [Workspace::STATUS_LABELS[s], s] }, {}, class: "l-field" %></div>
      </div>
      <%= f.submit "Lưu", class: "l-btn l-btn-primary" %>
    <% end %>
    <div style="margin-top:16px; display:flex; gap:8px; flex-wrap:wrap;">
      <%= button_to "Mở back office", impersonate_admin_workspace_path(@workspace), class: "l-btn l-btn-soft", form: { data: { turbo: false } } %>
      <%= button_to "Tạm ngưng", suspend_admin_workspace_path(@workspace), method: :patch, class: "l-btn l-btn-ghost" %>
      <%= button_to "Kích hoạt", reactivate_admin_workspace_path(@workspace), method: :patch, class: "l-btn l-btn-ghost" %>
    </div>
  </div>

  <div class="l-panel">
    <div style="font-weight:700; margin-bottom:12px;">Hồ bơi</div>
    <% if @pools.empty? %>
      <p style="color:var(--ink-2); font-size:13.5px;">Chưa có hồ nào. BOD tạo trong cổng điều hành.</p>
    <% else %>
      <table class="l-table">
        <tbody>
          <% @pools.each do |pool| %>
            <tr><td><strong><%= pool.name %></strong><div style="font-size:12px; color:var(--ink-2);"><%= pool.address %></div></td>
                <td style="text-align:right;"><span class="l-chip"><%= pool.status %></span></td></tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
