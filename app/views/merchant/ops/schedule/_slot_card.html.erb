<% cls = slot.swim_class %>
<% if slot.free? %>
  <%= link_to new_merchant_ops_registration_path(teacher_id: slot.teacher.id, hour: slot.hour, date: slot.date),
        style: "display:block; text-decoration:none; color:inherit; border:1.5px dashed var(--line); border-radius:12px; padding:12px; background:var(--surface);" do %>
    <div style="display:flex; justify-content:space-between; align-items:baseline;">
      <div style="font-weight:700; font-size:14px;"><%= format("%02d:00", slot.hour) %></div>
      <span class="l-chip">Slot trống</span>
    </div>
    <div style="font-size:13px; margin-top:6px;"><%= slot.teacher.display_name %></div>
    <div style="font-size:12px; color:var(--ink-2);">
      <%= slot.teacher.level_label %> · đã đăng ký dạy, chưa có học viên
    </div>
    <div style="font-size:12.5px; color:var(--primary); font-weight:600; margin-top:8px;">+ Xếp học viên vào slot này</div>
  <% end %>
<% else %>
  <% lesson = slot.lesson %>
  <%= link_to merchant_ops_lesson_path(lesson),
        style: "display:block; text-decoration:none; color:inherit; border:1px solid var(--line); border-radius:12px; padding:12px; background:#fff;" do %>
    <div style="display:flex; justify-content:space-between; align-items:baseline;">
      <div style="font-weight:700; font-size:14px;"><%= format("%02d:00", slot.hour) %></div>
      <% if slot.rental? %>
        <span class="l-chip">Thuê hồ</span>
      <% elsif cls.full? %>
        <span class="l-chip">Đã kín</span>
      <% else %>
        <span class="l-chip l-chip-brand">còn <%= cls.seats_left %> chỗ</span>
      <% end %>
    </div>
    <div style="font-size:13px; margin-top:6px; font-weight:600;">
      <%= slot.teacher.display_name %> · 1:<%= cls.class_type %> <%= cls.code %>
    </div>
    <div style="font-size:12px; color:var(--ink-2);">
      Buổi <%= lesson.session_index %>/<%= cls.total_sessions %> · <%= lesson.title %>
    </div>
    <div style="margin-top:8px; display:flex; flex-wrap:wrap; gap:4px;">
      <% cls.active_enrollments.each do |e| %>
        <span class="l-chip" style="font-size:11px; padding:3px 8px;">
          <%= e.student.short_name %> · <%= e.sessions_used %>/<%= e.total_available %>
        </span>
      <% end %>
      <% if cls.active_enrollments.empty? %>
        <span style="font-size:12px; color:var(--ink-2);">chưa có học viên</span>
      <% end %>
    </div>
  <% end %>
<% end %>
