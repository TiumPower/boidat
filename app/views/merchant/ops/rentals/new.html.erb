<% content_for :page_title, "Lịch thuê hồ mới" %>
<div class="l-panel" style="max-width:640px;">
  <%= form_with url: merchant_ops_rentals_path, method: :post, data: { turbo: false } do %>
    <% if @rental.errors.any? %>
      <div class="l-chip" style="background:#FBECEC; color:#9B2C2C; display:block; margin-bottom:14px;">
        <%= @rental.errors.full_messages.to_sentence %>
      </div>
    <% end %>
    <div style="margin-bottom:12px;">
      <label class="l-label">Người thuê</label>
      <%= select_tag :teacher_id, options_for_select(@renters.map { |t| ["#{t.display_name} · #{t.org_name}", t.id] }),
            class: "l-field", include_blank: "— chọn giáo viên thuê hồ —" %>
      <div style="font-size:12px; color:var(--ink-2); margin-top:4px;">
        Chưa có tên trong danh sách? Tạo giáo viên loại “Thuê hồ” ở cổng điều hành.
      </div>
    </div>
    <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:12px;">
      <div><label class="l-label">Giờ bắt đầu</label>
        <%= select_tag :start_hour, options_for_select((6..20).map { |h| [format("%02d:00", h), h] }), class: "l-field" %></div>
      <div><label class="l-label">Sức chứa</label>
        <%= number_field_tag :class_type, 4, class: "l-field", min: 1, max: 4 %></div>
      <div><label class="l-label">Số buổi sinh ra</label>
        <%= number_field_tag :sessions, 24, class: "l-field" %></div>
    </div>
    <div style="margin-bottom:12px;">
      <label class="l-label">Thuê các thứ</label>
      <div style="display:flex; gap:12px; flex-wrap:wrap; padding-top:6px;">
        <% %w[CN T2 T3 T4 T5 T6 T7].each_with_index do |label, wd| %>
          <label style="display:flex; gap:5px; align-items:center; font-size:13px;">
            <%= check_box_tag "weekdays[]", wd %> <%= label %>
          </label>
        <% end %>
      </div>
    </div>
    <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:18px;">
      <div><label class="l-label">Bắt đầu từ</label><%= date_field_tag :start_date, Date.current, class: "l-field" %></div>
      <div><label class="l-label">Giá thuê / giờ</label><%= number_field_tag :hourly_rate, 300000, class: "l-field", step: 10000 %></div>
      <div><label class="l-label">Số giờ tính tiền</label><%= number_field_tag :hours, 40, class: "l-field" %></div>
    </div>
    <%= submit_tag "Tạo lịch thuê", class: "l-btn l-btn-primary" %>
    <%= link_to "Huỷ", merchant_ops_rentals_path, class: "l-btn l-btn-ghost" %>
  <% end %>
</div>
