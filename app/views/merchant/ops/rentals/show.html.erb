<% content_for :page_title, "Thuê hồ · #{@rental.teacher.display_name}" %>
<% content_for :page_sub, "#{@rental.teacher.org_name} · #{@rental.slot_label}" %>
<% content_for :back do %><%= link_to "← Lớp thuê hồ", merchant_ops_rentals_path, class: "l-btn l-btn-ghost", style: "padding:6px 12px; font-size:13px;" %><% end %>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; align-items:start;">
  <div class="l-panel">
    <div style="font-weight:700; margin-bottom:12px;">Học viên (<%= @rental.seats_taken %>)</div>
    <table class="l-table">
      <thead><tr><th>Học viên</th><th>Buổi</th><th>Ảnh khuôn mặt</th></tr></thead>
      <tbody>
        <% @rental.enrollments.each do |e| %>
          <tr>
            <td><%= e.student.name %></td>
            <td><%= e.progress_label %></td>
            <td style="font-size:13px; color:var(--ink-2);"><%= e.student.face_registered? ? "Đã có" : "Chưa có" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @rental.enrollments.empty? %>
      <p style="font-size:13.5px; color:var(--ink-2);">Khách thuê chưa khai học viên nào.</p>
    <% end %>
  </div>

  <div class="l-panel">
    <div style="font-weight:700; margin-bottom:12px;">Hoá đơn thuê hồ</div>
    <% @orders.each do |order| %>
      <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid var(--line); font-size:13.5px;">
        <span><%= order.code %> · <%= order.note %></span>
        <span><strong><%= vnd(order.total) %></strong> <span class="l-chip"><%= order.status_label %></span></span>
      </div>
    <% end %>
    <% if @orders.empty? %>
      <p style="font-size:13.5px; color:var(--ink-2);">Chưa có hoá đơn thuê hồ.</p>
    <% end %>
    <p style="font-size:12px; color:var(--ink-2); margin-top:12px;">
      Nhóm này không có chấm công, giáo án hay nhận xét — chỉ điểm danh để trừ buổi.
    </p>
  </div>
</div>
