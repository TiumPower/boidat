<% content_for :page_title, "Hộp thư chat" %>
<% content_for :page_sub, "FR-224 · #{current_pool.name} · #{@unread_total} tin chưa đọc" %>

<div class="l-panel" style="margin-bottom:16px;">
  <%= form_with url: merchant_ops_conversations_path, method: :get, data: { turbo: false } do %>
    <%= search_field_tag :q, @q, class: "l-field", style: "width:auto; min-width:280px;",
          placeholder: "Tìm theo tên hộ / học viên…" %>
  <% end %>
</div>

<div class="l-panel">
  <% @conversations.each do |c| %>
    <%= link_to merchant_ops_conversation_path(c),
          style: "display:flex; justify-content:space-between; align-items:center; padding:12px 0; border-bottom:1px solid var(--line); text-decoration:none; color:inherit;" do %>
      <div style="min-width:0;">
        <div style="font-weight:600; font-size:14px;">
          <%= c.household.name %>
          <span style="font-weight:400; color:var(--ink-2); font-size:12.5px;">
            (<%= c.household.students.map(&:short_name).join(", ") %>)
          </span>
        </div>
        <div style="font-size:12.5px; color:var(--ink-2); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
          <%= c.last_preview %>
        </div>
      </div>
      <div style="text-align:right; white-space:nowrap; padding-left:12px;">
        <div style="font-size:12px; color:var(--ink-2);">
          <%= c.last_message_at ? l(c.last_message_at, format: "%H:%M %d/%m") : "" %>
        </div>
        <% if c.staff_unread.positive? %>
          <span class="l-chip l-chip-brand" style="margin-top:4px;"><%= c.staff_unread %> mới</span>
        <% end %>
      </div>
    <% end %>
  <% end %>
  <% if @conversations.empty? %>
    <p style="font-size:13.5px; color:var(--ink-2);">Chưa có hội thoại nào tại hồ này.</p>
  <% end %>
</div>
