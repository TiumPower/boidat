<% content_for :page_title, "Học viên · #{current_pool.name}" %>
<% content_for :page_sub, "FR-206 · #{@students.size} em" %>

<div class="l-panel" style="margin-bottom:16px;">
  <%= form_with url: merchant_ops_students_path, method: :get, data: { turbo: false },
        style: "display:flex; gap:10px; align-items:center; flex-wrap:wrap;" do %>
    <%= search_field_tag :q, @q, class: "l-field", style: "width:auto; min-width:260px;", placeholder: "Tìm học viên…" %>
    <div style="display:inline-flex; border:1px solid var(--line); border-radius:999px; overflow:hidden;">
      <% [[nil, "Tất cả"], ["center", "Của trung tâm"], ["renter", "Thuê hồ"]].each do |key, label| %>
        <% on = @kind == key %>
        <%= link_to "#{label}#{key ? " (#{@counts[key].to_i})" : ''}", merchant_ops_students_path(kind: key, q: @q),
              style: "padding:6px 14px; font-size:12.5px; font-weight:700; text-decoration:none; #{on ? 'background:var(--primary); color:#fff;' : 'color:var(--ink-2);'}" %>
      <% end %>
    </div>
    <%= link_to "Hộ gia đình →", merchant_ops_households_path, class: "l-btn l-btn-soft", style: "margin-left:auto;" %>
  <% end %>
</div>

<div class="l-panel">
  <table class="l-table">
    <thead><tr><th>Học viên</th><th>Tuổi</th><th>Hộ gia đình</th><th>Ảnh khuôn mặt</th><th>Loại</th><th></th></tr></thead>
    <tbody>
      <% @students.each do |st| %>
        <tr>
          <td><strong><%= st.name %></strong>
            <% if st.health_notes.present? %>
              <div style="font-size:12px; color:#B4402F;">⚠ <%= st.health_notes %></div>
            <% end %></td>
          <td><%= st.age_label %></td>
          <td style="font-size:13px; color:var(--ink-2);"><%= st.household.name %></td>
          <td>
            <% if st.face_registered? %>
              <span class="l-chip l-chip-brand">Đã có ảnh</span>
            <% else %>
              <span class="l-chip" style="background:#FBF1E4; color:#8A5B12;">Chưa có ảnh</span>
            <% end %>
          </td>
          <td><%= st.kind == "renter" ? "Thuê hồ" : "Trung tâm" %></td>
          <td style="text-align:right;"><%= link_to "Hồ sơ", merchant_ops_student_path(st), class: "l-btn l-btn-soft", style: "padding:5px 12px; font-size:12.5px;" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
