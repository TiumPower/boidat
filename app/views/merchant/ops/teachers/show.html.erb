<% content_for :page_title, @teacher.display_name %>
<% content_for :page_sub, @teacher.renter? ? "Thuê hồ" : @teacher.level_label %>
<% content_for :back do %><%= link_to "← Giáo viên", merchant_ops_teachers_path, class: "l-btn l-btn-ghost", style: "padding:6px 12px; font-size:13px;" %><% end %>
<% content_for :actions do %>
  <%= link_to "Lịch dạy tháng sau", availability_merchant_ops_teacher_path(@teacher), class: "l-btn l-btn-primary" %>
<% end %>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; align-items:start;">
  <div class="l-panel">
    <div style="font-weight:700; margin-bottom:12px;">Hồ sơ</div>
    <table class="l-table">
      <tbody>
        <tr><td style="color:var(--ink-2);">Điện thoại</td><td><%= @teacher.phone %></td></tr>
        <tr><td style="color:var(--ink-2);">Chuyên môn</td><td><%= @teacher.specialty %></td></tr>
        <tr><td style="color:var(--ink-2);">Kinh nghiệm</td><td><%= @teacher.years_experience %> năm</td></tr>
        <tr><td style="color:var(--ink-2);">Tối đa mỗi tiết</td><td><%= @teacher.capacity %> học viên</td></tr>
      </tbody>
    </table>
    <p style="font-size:13px; color:var(--ink-2); margin-top:12px;"><%= @teacher.bio %></p>
  </div>
  <div>
    <div class="l-panel" style="margin-bottom:16px;">
      <div style="font-weight:700; margin-bottom:8px;">Lịch dạy tháng <%= @next_month.strftime("%m/%Y") %></div>
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <div style="font-size:13.5px; color:var(--ink-2);">
          <% if @availability_count.positive? %>
            <strong style="color:var(--ink);"><%= @availability_count %> ca</strong> tại <%= current_pool.short_name %>
            · <%= @submitted ? "đã gửi" : "bản nháp" %>
          <% else %>
            <strong style="color:#B4402F;">Chưa gửi lịch</strong> — bộ xếp lịch sẽ không có gì để xếp
          <% end %>
        </div>
        <%= link_to @availability_count.positive? ? "Sửa hộ" : "Set hộ", availability_merchant_ops_teacher_path(@teacher),
              class: "l-btn l-btn-soft", style: "padding:6px 12px; font-size:12.5px;" %>
      </div>
    </div>

    <div class="l-panel" style="background:var(--surface-2);">
      <div style="font-weight:700; margin-bottom:6px;">Chấm công & đơn xin nghỉ</div>
      <p style="font-size:13.5px; color:var(--ink-2); margin:0 0 10px;">
        Công tự tính từ dữ liệu điểm danh, không ai nhập tay.
      </p>
      <%= link_to "Xem bảng chấm công", merchant_ops_timesheets_path, class: "l-btn l-btn-soft",
            style: "padding:6px 12px; font-size:12.5px;" %>
      <%= link_to "Đơn xin nghỉ", merchant_ops_leave_requests_path, class: "l-btn l-btn-soft",
            style: "padding:6px 12px; font-size:12.5px;" %>
    </div>
  </div>
</div>
