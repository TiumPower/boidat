<% content_for :page_title, @household.name %>
<% content_for :back do %><%= link_to "← Hộ gia đình", merchant_ops_households_path, class: "l-btn l-btn-ghost", style: "padding:6px 12px; font-size:13px;" %><% end %>

<div style="display:grid; grid-template-columns:1fr 340px; gap:16px; align-items:start;">
  <div class="l-panel">
    <div style="font-weight:700; margin-bottom:12px;">Học viên trong hộ</div>
    <table class="l-table">
      <thead><tr><th>Học viên</th><th>Tuổi</th><th>Hồ</th><th>Ảnh khuôn mặt</th></tr></thead>
      <tbody>
        <% @students.each do |st| %>
          <tr>
            <td><%= link_to st.name, merchant_ops_student_path(st), style: "font-weight:600;" %></td>
            <td><%= st.age_label %></td>
            <td><%= st.pool.short_name %></td>
            <td><%= st.face_registered? ? "Đã có" : "Chưa có" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="l-eyebrow" style="margin:20px 0 10px;">Người giám hộ</div>
    <% @household.guardians.each do |g| %>
      <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid var(--line);">
        <div>
          <div style="font-weight:600; font-size:14px;"><%= g.name %></div>
          <div style="font-size:12px; color:var(--ink-2);">
            <%= g.role_label %><%= " · xem được thanh toán" if g.can_view_payments? %>
          </div>
        </div>
        <div style="font-size:13px; color:var(--ink-2);"><%= g.phone %></div>
      </div>
    <% end %>
  </div>

  <div class="l-panel" style="text-align:center;">
    <div style="font-weight:700; margin-bottom:4px;">Mã QR đăng nhập</div>
    <p style="font-size:12.5px; color:var(--ink-2);">Phụ huynh quét mã này là vào thẳng app, không cần mật khẩu.</p>
    <% if @household.qr_active? %>
      <div style="margin:14px auto; width:220px;"><%= qr_svg(@qr_url, size: 220) %></div>
    <% else %>
      <div style="margin:20px 0; font-size:13px; color:#B4402F;">Mã đã bị thu hồi.</div>
    <% end %>
    <%= button_to "Thu hồi & cấp mã mới", reissue_qr_merchant_ops_household_path(@household),
          class: "l-btn l-btn-soft l-btn-block",
          form: { data: { turbo_confirm: "Cấp mã mới? Mã cũ sẽ không dùng được nữa và cả nhà phải quét lại." } } %>
    <p style="font-size:12px; color:var(--ink-2); margin-top:10px;">
      Dùng khi phụ huynh mất điện thoại, đổi số, hoặc gia đình nghỉ rồi quay lại.
    </p>
  </div>
</div>
