<% content_for :page_title, "Hộ gia đình" %>
<% content_for :page_sub, "FR-206 · mỗi hộ một mã QR đăng nhập" %>

<div class="l-panel" style="margin-bottom:16px;">
  <%= form_with url: merchant_ops_households_path, method: :get, data: { turbo: false } do %>
    <%= search_field_tag :q, @q, class: "l-field", style: "width:auto; min-width:280px;", placeholder: "Tìm hộ gia đình…" %>
  <% end %>
</div>

<div class="l-panel">
  <table class="l-table">
    <thead><tr><th>Hộ gia đình</th><th>Người giám hộ</th><th>Học viên</th><th>Mã QR</th><th></th></tr></thead>
    <tbody>
      <% @households.each do |h| %>
        <tr>
          <td><strong><%= h.name %></strong><div style="font-size:12px; color:var(--ink-2);"><%= h.individual? ? "Người lớn tự học" : "Hộ gia đình" %></div></td>
          <td style="font-size:13px; color:var(--ink-2);"><%= h.guardians.map(&:name).join(", ") %></td>
          <td style="font-size:13px;"><%= h.students.map(&:name).join(", ") %></td>
          <td><span class="l-chip <%= 'l-chip-brand' if h.qr_active? %>"><%= h.qr_active? ? "Còn hiệu lực" : "Đã thu hồi" %></span></td>
          <td style="text-align:right;"><%= link_to "Mở", merchant_ops_household_path(h), class: "l-btn l-btn-soft", style: "padding:5px 12px; font-size:12.5px;" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
