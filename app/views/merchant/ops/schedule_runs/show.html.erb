<% content_for :page_title, "Lịch nháp tháng #{@run.month_label}" %>
<% content_for :back do %><%= link_to "← Xếp lịch tự động", merchant_ops_schedule_runs_path, class: "l-btn l-btn-ghost", style: "padding:6px 12px; font-size:13px;" %><% end %>

<div class="l-panel" style="margin-bottom:16px; <%= 'background:var(--surface-2);' if @run.applied? %>">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
    <div>
      <div style="font-weight:700;">
        <%= @run.status_label %> · <%= @rows.size %> khung giờ
      </div>
      <div style="font-size:12.5px; color:var(--ink-2);">
        <%= @run.metrics["locked_classes"] %> lớp đang chạy được khoá cứng ·
        <%= @run.metrics["availability_submitted"] %> giáo viên đã gửi lịch ·
        mỗi khung ước tính <%= @run.metrics["expected_credit_per_slot"] %> công
      </div>
    </div>
    <% if @run.draft? %>
      <%= button_to "Bỏ bản nháp", discard_merchant_ops_schedule_run_path(@run), method: :patch,
            class: "l-btn l-btn-ghost" %>
    <% end %>
  </div>

  <% spread = @run.metrics["credit_stddev_by_level"] || {} %>
  <% if spread.any? %>
    <div style="margin-top:12px; display:flex; gap:14px; flex-wrap:wrap;">
      <% spread.each do |level, value| %>
        <div style="font-size:12.5px;">
          <span style="color:var(--ink-2);">Lệch công <%= level %>:</span>
          <strong style="color:<%= value.to_f > 3 ? '#B4402F' : 'var(--ink)' %>;"><%= value %></strong>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<%= form_with url: apply_merchant_ops_schedule_run_path(@run), method: :patch, data: { turbo: false } do %>
  <div class="l-panel">
    <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:12px;">
      <div style="font-weight:700;">Khung giờ đề xuất</div>
      <div style="font-size:12.5px; color:var(--ink-2);">Bỏ tích những khung không muốn mở</div>
    </div>

    <% @by_teacher.each do |teacher_name, rows| %>
      <div style="margin-bottom:14px;">
        <div class="l-eyebrow" style="margin-bottom:6px;"><%= teacher_name %> · <%= rows.size %> khung</div>
        <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:8px;">
          <% rows.each do |row| %>
            <% key = "#{row[:teacher_id]}:#{row[:weekday]}:#{row[:hour]}" %>
            <label style="border:1px solid var(--line); border-radius:10px; padding:9px 11px; display:flex; gap:8px; align-items:flex-start; cursor:pointer; font-size:13px;">
              <% if @run.draft? %>
                <%= check_box_tag "keep[]", key, true %>
              <% end %>
              <span>
                <strong><%= %w[CN T2 T3 T4 T5 T6 T7][row[:weekday].to_i] %> · <%= format("%02d:00", row[:hour].to_i) %></strong>
                <div style="font-size:11.5px; color:var(--ink-2);"><%= row[:reason] %></div>
              </span>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @rows.empty? %>
      <p style="font-size:13.5px; color:var(--ink-2);">
        Không có khung nào trống — hoặc giáo viên chưa gửi lịch đăng ký, hoặc mọi khung đã có lớp.
      </p>
    <% end %>

    <% if @run.draft? && @rows.any? %>
      <div style="margin-top:16px; padding-top:14px; border-top:1px solid var(--line);">
        <%= submit_tag "Áp dụng vào lịch thật", class: "l-btn l-btn-primary",
              data: { turbo_confirm: "Áp dụng? Các khung đã tích sẽ hiện là slot trống trên bảng lịch để sale chốt học viên." } %>
        <span style="font-size:12.5px; color:var(--ink-2); margin-left:12px;">
          Áp dụng chỉ mở các khung này cho sale chốt học viên — hệ thống không tự tạo lớp khi chưa có ai đăng ký.
        </span>
      </div>
    <% end %>
  </div>
<% end %>
