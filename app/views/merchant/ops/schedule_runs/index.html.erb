<% content_for :page_title, "Xếp lịch tự động" %>
<% content_for :page_sub, "FR-205 · #{current_pool.name}" %>

<div style="display:grid; grid-template-columns:1fr 360px; gap:16px; align-items:start;">
  <div>
    <div class="l-panel" style="margin-bottom:16px;">
      <div style="font-weight:700; margin-bottom:6px;">Chạy xếp lịch cho tháng</div>
      <p style="font-size:12.5px; color:var(--ink-2); margin-bottom:14px;">
        Bộ xếp lịch <strong>chỉ xếp phần còn trống</strong>. Mọi lớp chưa kết thúc khoá đều được
        khoá cứng — học viên đã mua khoá thì không bị đổi thầy đổi giờ giữa chừng.
      </p>
      <%= form_with url: merchant_ops_schedule_runs_path, method: :post, data: { turbo: false },
            style: "display:flex; gap:10px; align-items:center;" do %>
        <%= month_field_tag :month, @month.strftime("%Y-%m"), class: "l-field", style: "width:auto;" %>
        <%= submit_tag "Chạy bản nháp", class: "l-btn l-btn-primary",
              disabled: !@readiness[:ready] %>
        <% unless @readiness[:ready] %>
          <span style="font-size:12.5px; color:#B4402F;">Chưa giáo viên nào gửi lịch đăng ký cho tháng này</span>
        <% end %>
      <% end %>
    </div>

    <div class="l-panel">
      <div style="font-weight:700; margin-bottom:12px;">Các lần chạy</div>
      <table class="l-table">
        <thead><tr><th>Tháng</th><th>Khung đề xuất</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
          <% @runs.each do |run| %>
            <tr>
              <td><strong><%= run.month_label %></strong></td>
              <td><%= run.proposal_rows.size %></td>
              <td><span class="l-chip <%= 'l-chip-brand' if run.applied? %>"><%= run.status_label %></span></td>
              <td style="text-align:right;"><%= link_to "Xem", merchant_ops_schedule_run_path(run), class: "l-btn l-btn-soft", style: "padding:5px 12px; font-size:12.5px;" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @runs.empty? %>
        <p style="font-size:13.5px; color:var(--ink-2);">Chưa chạy lần nào.</p>
      <% end %>
    </div>
  </div>

  <div class="l-panel">
    <div style="font-weight:700; margin-bottom:12px;">Đầu vào của thuật toán</div>
    <table class="l-table">
      <tbody>
        <tr><td style="color:var(--ink-2);">Lịch hoạt động của hồ</td><td>Đã có</td></tr>
        <tr><td style="color:var(--ink-2);">Giáo viên đã gửi lịch</td>
            <td><strong><%= @readiness[:submitted] %></strong>/<%= @readiness[:teachers] %> GV</td></tr>
        <tr><td style="color:var(--ink-2);">Lớp đang chạy (khoá cứng)</td><td><%= @readiness[:running_classes] %> lớp</td></tr>
        <tr><td style="color:var(--ink-2);">Level & sức chứa</td><td>Đã cấu hình</td></tr>
      </tbody>
    </table>
    <p style="font-size:12px; color:var(--ink-2); margin-top:12px;">
      “Phân bổ đồng đều” đo bằng <strong>độ lệch chuẩn số công</strong> giữa các giáo viên cùng cấp độ —
      không phải số tiết. Hai người cùng 20 tiết nhưng một người toàn lớp 1:1 thì thu nhập chênh gấp ba.
    </p>
  </div>
</div>
