<% content_for :page_title, "Gói & bảng giá · #{current_pool.name}" %>
<% content_for :page_sub, "Chỉ đọc — quyền sửa giá thuộc Ban giám đốc" %>

<div class="l-panel" style="margin-bottom:16px;">
  <table class="l-table">
    <thead><tr><th>Gói</th><th>Loại</th><th>Lớp</th><th>Số buổi</th><th>Giá tại hồ này</th><th>Hạn dùng</th></tr></thead>
    <tbody>
      <% @packages.each do |pkg| %>
        <tr>
          <td><strong><%= pkg.name %></strong><div style="font-size:12px; color:var(--ink-2);"><%= pkg.description %></div></td>
          <td><%= pkg.kind_label %></td>
          <td><%= pkg.class_type_label %></td>
          <td><%= pkg.session_count || "—" %></td>
          <td><strong><%= pkg.price_label(current_pool) %></strong></td>
          <td style="font-size:13px; color:var(--ink-2);"><%= pkg.expiry_days %> ngày</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @promotions.any? %>
  <div class="l-eyebrow" style="margin-bottom:10px;">Khuyến mãi đang chạy</div>
  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:12px;">
    <% @promotions.each do |p| %>
      <div class="l-panel">
        <div style="font-weight:700; font-size:14px;"><%= p.name %></div>
        <div style="font-size:18px; font-weight:700; color:var(--primary); margin:6px 0;"><%= p.value_label %></div>
        <div style="font-size:12.5px; color:var(--ink-2);"><%= p.condition_note %></div>
      </div>
    <% end %>
  </div>
<% end %>
