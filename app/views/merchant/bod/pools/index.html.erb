<% content_for :page_title, "Hồ bơi & lịch hoạt động" %>
<% content_for :page_sub, "FR-111 · FR-112 · FR-217" %>
<% content_for :actions do %>
  <%= link_to "+ Hồ bơi mới", new_merchant_bod_pool_path, class: "l-btn l-btn-primary" %>
<% end %>

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:14px;">
  <% @pools.each do |pool| %>
    <div class="l-panel">
      <div style="display:flex; align-items:baseline; justify-content:space-between;">
        <div>
          <div style="font-weight:700; font-size:16px;"><%= pool.name %></div>
          <div style="font-size:12.5px; color:var(--ink-2);"><%= pool.address %></div>
        </div>
        <span class="l-chip <%= 'l-chip-brand' if pool.active? %>"><%= pool.active? ? "Đang hoạt động" : pool.status %></span>
      </div>

      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin:14px 0;">
        <div><div class="l-eyebrow">Học viên</div><div style="font-weight:700; font-size:18px;"><%= @student_counts[pool.id].to_i %></div></div>
        <div><div class="l-eyebrow">Giáo viên</div><div style="font-weight:700; font-size:18px;"><%= @teacher_counts[pool.id].to_i %></div></div>
        <div><div class="l-eyebrow">Nhân sự</div><div style="font-weight:700; font-size:18px;"><%= @staff_counts[pool.id].to_i %></div></div>
      </div>

      <div style="font-size:12.5px; color:var(--ink-2); margin-bottom:12px;">
        Hôm nay: <%= pool.hours_on(Date.current)&.map { |t| t.strftime("%H:%M") }&.join(" – ") || "nghỉ" %>
      </div>
      <%= link_to "Cấu hình hồ", merchant_bod_pool_path(pool), class: "l-btn l-btn-soft l-btn-block" %>
    </div>
  <% end %>
</div>
