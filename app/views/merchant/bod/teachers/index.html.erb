<% content_for :page_title, "Giáo viên" %>
<% content_for :page_sub, "FR-209 · FR-216 · giáo viên của trung tâm và khách thuê hồ" %>
<% content_for :actions do %>
  <%= link_to "Cấp độ", merchant_bod_teacher_levels_path, class: "l-btn l-btn-soft" %>
  <%= link_to "+ Giáo viên mới", new_merchant_bod_teacher_path, class: "l-btn l-btn-primary" %>
<% end %>

<div style="display:inline-flex; border:1px solid var(--line); border-radius:999px; overflow:hidden; margin-bottom:16px;">
  <% [[nil, "Tất cả", @counts.values.sum], ["staff", "Thuộc trung tâm", @counts["staff"].to_i],
      ["renter", "Thuê hồ", @counts["renter"].to_i]].each do |key, label, count| %>
    <% on = @kind == key %>
    <%= link_to "#{label} (#{count})", merchant_bod_teachers_path(kind: key),
          style: "padding:6px 16px; font-size:12.5px; font-weight:700; text-decoration:none; #{on ? 'background:var(--primary); color:#fff;' : 'color:var(--ink-2);'}" %>
  <% end %>
</div>

<div class="l-panel">
  <table class="l-table">
    <thead><tr><th>Giáo viên</th><th>Loại</th><th>Cấp độ</th><th>Tối đa / tiết</th><th>Hồ</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
      <% @teachers.each do |t| %>
        <tr>
          <td><strong><%= t.display_name %></strong>
            <div style="font-size:12px; color:var(--ink-2);">
              <%= [t.specialty, t.years_experience && "#{t.years_experience} năm"].compact.join(" · ") %>
            </div></td>
          <td>
            <% if t.renter? %>
              <span class="l-chip">Thuê hồ<%= " · #{t.org_name}" if t.org_name %></span>
            <% else %>
              <span class="l-chip l-chip-brand">Thuộc trung tâm</span>
            <% end %>
          </td>
          <td><%= t.renter? ? "—" : t.level_label %></td>
          <td><%= t.renter? ? "—" : "#{t.capacity} HV" %></td>
          <td style="font-size:13px; color:var(--ink-2);"><%= t.pools.map(&:short_name).join(" · ") %></td>
          <td><span class="l-chip"><%= t.status_label %></span></td>
          <td style="text-align:right;"><%= link_to "Hồ sơ", merchant_bod_teacher_path(t), class: "l-btn l-btn-soft", style: "padding:5px 12px; font-size:12.5px;" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="l-panel" style="margin-top:16px; background:var(--surface-2);">
  <div style="font-weight:700; margin-bottom:6px;">Hai mô hình khác nhau, không phải một checkbox</div>
  <p style="font-size:13.5px; color:var(--ink-2); margin:0;">
    <strong>Thuộc trung tâm</strong>: đủ nghiệp vụ — giáo án, nhận xét, chấm công, xếp lịch tự động.
    <strong>Thuê hồ</strong>: khách thuê giờ để tự dạy học viên của họ; trung tâm chỉ giữ khung giờ thuê
    và điểm danh trừ buổi, doanh thu ghi vào dòng “cho thuê hồ” riêng.
  </p>
</div>
