<% content_for :page_title, "Khoá học & giáo án" %>
<% content_for :page_sub, "FR-212 · loại lớp 1:1 → 1:4" %>
<% content_for :actions do %>
  <%= link_to "+ Khoá học mới", new_merchant_bod_course_path, class: "l-btn l-btn-primary" %>
<% end %>

<% if @courses.empty? %>
  <div class="l-panel" style="text-align:center; padding:36px;">
    <div style="font-size:34px;">🏊</div>
    <div style="font-weight:700; margin-top:10px;">Chưa có khoá học nào</div>
    <p style="font-size:13.5px; color:var(--ink-2);">Tạo khoá đầu tiên rồi điền giáo án từng buổi — giáo viên sẽ thấy nội dung này trên PWA.</p>
    <%= link_to "+ Khoá học mới", new_merchant_bod_course_path, class: "l-btn l-btn-primary" %>
  </div>
<% else %>
  <div class="l-panel">
    <table class="l-table">
      <thead><tr><th>Khoá học</th><th>Đối tượng</th><th>Số buổi</th><th>Loại lớp</th><th>Giáo án</th><th>Gói bán</th><th></th></tr></thead>
      <tbody>
        <% @courses.each do |c| %>
          <tr>
            <td><strong><%= c.name %></strong><div style="font-size:12px; color:var(--ink-2);"><%= c.description&.truncate(60) %></div></td>
            <td><%= c.audience_label %></td>
            <td><%= c.total_sessions %> buổi<div style="font-size:12px; color:var(--ink-2);">thi ở buổi <%= c.exam_session %></div></td>
            <td><%= c.class_type_label %></td>
            <td><%= c.course_sessions.size %>/<%= c.total_sessions %> buổi đã có giáo án</td>
            <td><%= c.packages.size %></td>
            <td style="text-align:right;"><%= link_to "Mở", merchant_bod_course_path(c), class: "l-btn l-btn-soft", style: "padding:5px 12px; font-size:12.5px;" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
