<% content_for :page_title, @course.name %>
<% content_for :page_sub, "#{@course.audience_label} · #{@course.total_sessions} buổi · #{@course.class_type_label}" %>
<% content_for :back do %><%= link_to "← Khoá học", merchant_bod_courses_path, class: "l-btn l-btn-ghost", style: "padding:6px 12px; font-size:13px;" %><% end %>
<% content_for :actions do %>
  <%= link_to "Sửa khoá", edit_merchant_bod_course_path(@course), class: "l-btn l-btn-soft" %>
  <%= link_to "+ Gói bán", new_merchant_bod_package_path(course_id: @course.id), class: "l-btn l-btn-primary" %>
<% end %>

<div style="display:grid; grid-template-columns:1fr 320px; gap:16px; align-items:start;">
  <div class="l-panel">
    <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:4px;">
      <div style="font-weight:700;">Giáo án từng buổi</div>
      <% if @sessions.size < @course.total_sessions %>
        <%= button_to "Tạo khung #{@course.total_sessions} buổi", generate_plan_merchant_bod_course_path(@course),
              class: "l-btn l-btn-soft", style: "padding:5px 12px; font-size:12.5px;" %>
      <% end %>
    </div>
    <p style="font-size:12.5px; color:var(--ink-2); margin-bottom:14px;">
      Đây là bản mặc định. Giáo viên sửa được nội dung cho riêng buổi mình dạy mà không đụng bản gốc.
    </p>

    <%= form_with url: merchant_bod_course_path(@course), method: :patch, data: { turbo: false } do %>
      <%= hidden_field_tag "course[name]", @course.name %>
      <% @sessions.each do |s| %>
        <div style="border:1px solid var(--line); border-radius:12px; padding:12px; margin-bottom:10px; <%= 'background:var(--surface-2);' if s.exam %>">
          <div style="display:grid; grid-template-columns:60px 1fr 1fr; gap:10px; align-items:end;">
            <div style="font-weight:700; font-size:15px; padding-bottom:10px;">B<%= s.position %></div>
            <div><label class="l-label">Tiêu đề</label>
              <%= text_field_tag "sessions[#{s.position}][title]", s.title, class: "l-field" %></div>
            <div><label class="l-label">Mục tiêu đạt được</label>
              <%= text_field_tag "sessions[#{s.position}][goal]", s.goal, class: "l-field", placeholder: "Nổi 10 giây" %></div>
          </div>
          <div style="margin-top:8px;">
            <%= text_area_tag "sessions[#{s.position}][content]", s.content, class: "l-field", rows: 2,
                  placeholder: "Khởi động 5 phút · tập thở nghiêng 2×15m có phao…" %>
          </div>
          <label style="display:inline-flex; gap:6px; align-items:center; font-size:12.5px; margin-top:8px;">
            <%= check_box_tag "sessions[#{s.position}][exam]", "1", s.exam %> Buổi thi tốt nghiệp
          </label>
        </div>
      <% end %>
      <% if @sessions.any? %>
        <%= submit_tag "Lưu giáo án", class: "l-btn l-btn-primary", style: "margin-top:8px;" %>
      <% end %>
    <% end %>
  </div>

  <div class="l-panel">
    <div style="font-weight:700; margin-bottom:12px;">Gói bán của khoá này</div>
    <% if @packages.empty? %>
      <p style="font-size:13px; color:var(--ink-2);">Chưa có gói nào. Tạo gói để sale bán được khoá này.</p>
    <% else %>
      <% @packages.each do |pkg| %>
        <%= link_to merchant_bod_package_path(pkg), style: "display:block; padding:10px 0; border-bottom:1px solid var(--line); text-decoration:none; color:inherit;" do %>
          <div style="font-weight:600; font-size:14px;"><%= pkg.name %></div>
          <div style="font-size:12px; color:var(--ink-2);">
            <%= pkg.kind_label %> · <%= pkg.class_type_label %> · <%= pkg.session_count %> buổi
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
