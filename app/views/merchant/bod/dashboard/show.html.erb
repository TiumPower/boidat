<% content_for :page_title, "Bảng điều khiển tổng hợp" %>
<% content_for :page_sub, "FR-101 · FR-102 · #{@pools.size} hồ" %>

<%# ---- Bộ lọc phạm vi & kỳ (FR-101) ---- %>
<div class="l-panel" style="margin-bottom:16px;">
  <%= form_with url: merchant_bod_root_path, method: :get, data: { turbo: false },
        style: "display:flex; align-items:center; gap:12px; flex-wrap:wrap;" do %>
    <select name="pool_id" class="l-field" style="width:auto;" onchange="this.form.requestSubmit()">
      <option value="all" <%= "selected" if @scope_pool.blank? || @scope_pool == "all" %>>Tất cả hồ</option>
      <% @pools.each do |pool| %>
        <option value="<%= pool.id %>" <%= "selected" if @scope_pool == pool.id.to_s %>><%= pool.name %></option>
      <% end %>
    </select>
    <div style="display:inline-flex; border:1px solid var(--line); border-radius:999px; overflow:hidden;">
      <% PeriodFilter::KEYS.each do |key| %>
        <% on = @period.key == key %>
        <%= link_to PeriodFilter::LABELS[key], merchant_bod_root_path(period: key, pool_id: @scope_pool),
              style: "padding:6px 14px; font-size:12.5px; font-weight:700; text-decoration:none; #{on ? 'background:var(--primary); color:#fff;' : 'color:var(--ink-2);'}" %>
      <% end %>
    </div>
    <div style="margin-left:auto; font-size:12.5px; color:var(--ink-2);">
      Kỳ đang xem: <strong style="color:var(--ink);"><%= @period.range_label %></strong> · so với kỳ liền trước
    </div>
  <% end %>
</div>

<%# ---- Nhóm chỉ số (FR-102) ---- %>
<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:14px; margin-bottom:20px;">
  <div class="l-kpi" style="outline:2px solid var(--primary); outline-offset:-1px;">
    <div class="k">Doanh thu kỳ</div><div class="v" style="font-size:24px; color:var(--primary);">—</div>
    <div class="d" style="color:var(--ink-2);">nối vào ở P4 (đơn hàng &amp; PayOS)</div>
  </div>
  <div class="l-kpi"><div class="k">Học viên đang học</div><div class="v"><%= @stats[:students] %></div>
    <div class="d" style="color:var(--ink-2);">+<%= @stats[:new_students] %> mới trong kỳ</div></div>
  <div class="l-kpi"><div class="k">Giáo viên</div><div class="v"><%= @stats[:teachers] %></div></div>
  <div class="l-kpi"><div class="k">Số tiết đã dạy</div><div class="v">—</div>
    <div class="d" style="color:var(--ink-2);">1 tiết = 60 phút</div></div>
  <div class="l-kpi"><div class="k">Công giáo viên</div><div class="v">—</div>
    <div class="d" style="color:var(--ink-2);">P3</div></div>
  <div class="l-kpi"><div class="k">Tỷ lệ lấp đầy</div><div class="v">—</div>
    <div class="d" style="color:var(--ink-2);">tiết có HV ÷ tiết đã phân lịch</div></div>
</div>

<div class="l-panel">
  <div style="font-weight:700; margin-bottom:12px;">Hồ bơi</div>
  <table class="l-table">
    <thead><tr><th>Hồ</th><th>Địa chỉ</th><th>Học viên</th><th>Giáo viên</th><th></th></tr></thead>
    <tbody>
      <% @pools.each do |pool| %>
        <tr>
          <td><strong><%= pool.name %></strong></td>
          <td style="color:var(--ink-2);"><%= pool.address %></td>
          <td><%= Student.where(pool_id: pool.id, status: "active").count %></td>
          <td><%= pool.teachers.count %></td>
          <td style="text-align:right;"><%= link_to "Cấu hình", merchant_bod_pool_path(pool), class: "l-btn l-btn-soft" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
