<% content_for :page_title, "Màu chủ đạo & thương hiệu" %>
<% content_for :page_sub, "Áp dụng cho cả 5 cổng" %>

<div style="display:grid; grid-template-columns:1fr 360px; gap:16px; align-items:start;">
  <div class="l-panel">
    <div style="font-weight:700; margin-bottom:12px;">Bộ màu có sẵn</div>
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-bottom:22px;">
      <% Workspace::THEME_PRESETS.each do |key, preset| %>
        <%= button_to merchant_bod_appearance_path, method: :patch, params: { preset: key },
              form: { data: { turbo: false } },
              style: "border:1px solid var(--line); border-radius:14px; padding:14px; background:#fff; cursor:pointer; text-align:left; width:100%;" do %>
          <div style="display:flex; gap:6px; margin-bottom:8px;">
            <span style="width:26px;height:26px;border-radius:8px;background:<%= preset[:primary] %>;"></span>
            <span style="width:26px;height:26px;border-radius:8px;background:<%= preset[:primary_2] %>;"></span>
          </div>
          <div style="font-weight:600; font-size:13.5px;"><%= preset[:label] %></div>
        <% end %>
      <% end %>
    </div>

    <div style="font-weight:700; margin-bottom:12px;">Tuỳ chỉnh</div>
    <%= form_with url: merchant_bod_appearance_path, method: :patch, data: { turbo: false } do %>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
        <div><label class="l-label">Màu chính</label>
          <%= color_field_tag "theme[primary]", @workspace.theme_value(:primary), class: "l-field", style: "height:44px;" %></div>
        <div><label class="l-label">Màu phụ</label>
          <%= color_field_tag "theme[primary_2]", @workspace.theme_value(:primary_2), class: "l-field", style: "height:44px;" %></div>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
        <div><label class="l-label">Bo góc</label>
          <%= text_field_tag "theme[radius]", @workspace.theme_value(:radius), class: "l-field" %></div>
        <div><label class="l-label">Font</label>
          <%= select_tag "theme[font_body]",
                options_for_select(Workspace::FONT_STACKS.keys, @workspace.theme_value(:font_body)), class: "l-field" %></div>
      </div>

      <div class="l-eyebrow" style="margin:18px 0 10px;">Thương hiệu</div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
        <div><label class="l-label">Tên hiển thị ngắn</label>
          <%= text_field_tag "branding[logo_text]", @workspace.branding_value("logo_text"), class: "l-field" %></div>
        <div><label class="l-label">Slogan</label>
          <%= text_field_tag "branding[tagline]", @workspace.branding_value("tagline"), class: "l-field" %></div>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
        <div><label class="l-label">Thành phố</label>
          <%= text_field_tag "branding[city]", @workspace.branding_value("city"), class: "l-field" %></div>
        <div><label class="l-label">Hotline</label>
          <%= text_field_tag "branding[contact_phone]", @workspace.branding_value("contact_phone"), class: "l-field" %></div>
      </div>
      <div style="margin-bottom:16px;"><label class="l-label">Logo</label>
        <%= file_field_tag :logo, class: "l-field", accept: "image/*" %></div>
      <%= submit_tag "Áp dụng", class: "l-btn l-btn-primary" %>
    <% end %>
  </div>

  <div class="l-panel">
    <div style="font-weight:700; margin-bottom:12px;">Xem trước</div>
    <div style="border:1px solid var(--line); border-radius:16px; overflow:hidden;">
      <div style="background:<%= @workspace.theme_value(:primary) %>; color:<%= @workspace.theme_value(:on_primary) %>; padding:16px;">
        <div style="font-weight:700;"><%= @workspace.logo_initials %> · <%= @workspace.name %></div>
        <div style="font-size:12px; opacity:.85;"><%= @workspace.branding_value("tagline") %></div>
      </div>
      <div style="padding:16px; background:<%= @workspace.theme_value(:surface) %>;">
        <div style="background:#fff; border:1px solid <%= @workspace.theme_value(:line) %>; border-radius:<%= @workspace.css_radius %>; padding:14px;">
          <div style="font-size:13px; color:<%= @workspace.theme_value(:ink_2) %>;">Buổi học sắp tới</div>
          <div style="font-weight:700; color:<%= @workspace.theme_value(:ink) %>;">Thứ 4 · 17:00 · Thầy Minh</div>
        </div>
        <div style="margin-top:12px; text-align:center; background:<%= @workspace.theme_value(:primary) %>; color:<%= @workspace.theme_value(:on_primary) %>; border-radius:12px; padding:11px; font-weight:600; font-size:14px;">
          Xác nhận điểm danh
        </div>
      </div>
    </div>
    <p style="font-size:12.5px; color:var(--ink-2); margin-top:12px;">
      Màu chữ trên nền thương hiệu được chọn tự động theo tỷ lệ tương phản WCAG, nên màu nào cũng đọc được.
    </p>
  </div>
</div>
