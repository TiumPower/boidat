<%= form_with model: level, url: url, method: method, data: { turbo: false } do |f| %>
  <% if level.errors.any? %>
    <div class="l-chip" style="background:#FBECEC; color:#9B2C2C; display:block; margin-bottom:12px;">
      <%= level.errors.full_messages.to_sentence %>
    </div>
  <% end %>
  <div style="margin-bottom:10px;"><%= f.label :name, "Tên cấp độ", class: "l-label" %><%= f.text_field :name, class: "l-field", placeholder: "Level 5" %></div>
  <div style="margin-bottom:10px;"><%= f.label :max_students_per_slot, "Tối đa học viên / tiết", class: "l-label" %><%= f.number_field :max_students_per_slot, class: "l-field", min: 1, max: 8 %></div>
  <div style="margin-bottom:10px;"><%= f.label :pay_rate_per_credit, "Đơn giá mỗi công (đ)", class: "l-label" %><%= f.number_field :pay_rate_per_credit, class: "l-field", step: 1000 %></div>
  <div style="margin-bottom:10px;"><%= f.label :position, "Thứ tự", class: "l-label" %><%= f.number_field :position, class: "l-field" %></div>
  <div style="margin-bottom:14px;"><%= f.label :description, "Mô tả", class: "l-label" %><%= f.text_field :description, class: "l-field", placeholder: "Dạy nhóm & nâng cao" %></div>
  <%= f.submit submit_label, class: "l-btn l-btn-primary l-btn-block" %>
<% end %>
