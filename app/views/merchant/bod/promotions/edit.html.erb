<% content_for :page_title, "Sửa #{@promotion.name}" %>
<div class="l-panel" style="max-width:760px;">
  <%= render "merchant/bod/promotions/form", promotion: @promotion, url: merchant_bod_promotion_path(@promotion), method: :patch, submit_label: "Lưu" %>
  <div style="margin-top:18px; padding-top:16px; border-top:1px solid var(--line);">
    <%= button_to "Xoá khuyến mãi", merchant_bod_promotion_path(@promotion), method: :delete, class: "l-btn l-btn-ghost",
          form: { data: { turbo_confirm: "Xoá khuyến mãi này?" } } %>
  </div>
</div>
