<%= form_with model: promotion, url: url, method: method, data: { turbo: false } do |f| %>
  <% if promotion.errors.any? %>
    <div class="l-chip" style="background:#FBECEC; color:#9B2C2C; display:block; margin-bottom:14px;">
      <%= promotion.errors.full_messages.to_sentence %>
    </div>
  <% end %>
  <div style="margin-bottom:12px;"><%= f.label :name, "Tên khuyến mãi", class: "l-label" %>
    <%= f.text_field :name, class: "l-field", placeholder: "Tặng 1 buổi khi đăng ký khoá 12 buổi" %></div>
  <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:12px;">
    <div><%= f.label :kind, "Loại", class: "l-label" %>
      <%= f.select :kind, Promotion::KINDS.map { |k| [Promotion::KIND_LABELS[k], k] }, {}, class: "l-field" %></div>
    <div><%= f.label :value, "Giá trị", class: "l-label" %><%= f.number_field :value, class: "l-field" %>
      <div style="font-size:11.5px; color:var(--ink-2); margin-top:5px; line-height:1.45;">
        <% Promotion::VALUE_HINTS.each do |k, hint| %>
          <div><strong><%= Promotion::KIND_LABELS[k] %>:</strong> <%= hint %></div>
        <% end %>
      </div></div>
    <div><%= f.label :stock, "Số lượng (quà hiện vật)", class: "l-label" %><%= f.number_field :stock, class: "l-field" %></div>
  </div>
  <div style="margin-bottom:12px;"><%= f.label :condition_note, "Điều kiện áp dụng", class: "l-label" %>
    <%= f.text_area :condition_note, class: "l-field", rows: 2, placeholder: "Áp dụng học viên mới · tháng 9" %></div>
  <div style="display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:12px; margin-bottom:18px;">
    <div><%= f.label :pool_id, "Hồ áp dụng", class: "l-label" %>
      <%= f.collection_select :pool_id, accessible_pools, :id, :name, { include_blank: "Tất cả hồ" }, class: "l-field" %></div>
    <div><%= f.label :starts_on, "Từ ngày", class: "l-label" %><%= f.date_field :starts_on, class: "l-field" %></div>
    <div><%= f.label :ends_on, "Đến ngày", class: "l-label" %><%= f.date_field :ends_on, class: "l-field" %></div>
    <div><%= f.label :status, "Trạng thái", class: "l-label" %>
      <%= f.select :status, [["Đang chạy", "active"], ["Tạm dừng", "paused"]], {}, class: "l-field" %></div>
  </div>
  <%= f.submit submit_label, class: "l-btn l-btn-primary" %>
  <%= link_to "Huỷ", merchant_bod_promotions_path, class: "l-btn l-btn-ghost" %>
<% end %>
