<% content_for :title, "Đăng nhập" %>
<% content_for :no_tabbar, true %>
<div class="l-screen" style="padding:24px 20px;">
  <div style="font-family:var(--font-display); font-size:22px; font-weight:700;">Đăng nhập</div>
  <p style="font-size:13.5px; color:var(--ink-2); margin-top:4px;">
    Quét mã QR trung tâm đã cấp cho bạn — không cần mật khẩu.
  </p>

  <% if flash.now[:alert] || flash[:alert] %>
    <div class="l-chip" style="background:#FBECEC; color:#9B2C2C; display:block; margin:14px 0;"><%= flash[:alert] %></div>
  <% end %>

  <div class="l-panel" style="margin:20px 0 16px;">
    <div style="font-weight:700;">Mã QR của bạn</div>
    <div style="font-size:12.5px; color:var(--ink-2); margin-top:4px;">
      Mỗi người một mã riêng. Phụ huynh theo dõi được mọi con trong hộ;
      người lớn tự học dùng mã của chính mình.
    </div>
  </div>

  <%= form_with url: member_login_path, method: :post, data: { turbo: false } do %>
    <label class="l-label">Mã QR</label>
    <%= text_field_tag :qr_token, nil, class: "l-field", placeholder: "Dán mã hoặc đường dẫn QR", autofocus: true %>
    <%= submit_tag "Vào ứng dụng", class: "l-btn l-btn-primary l-btn-block", style: "margin-top:14px;" %>
    <p style="font-size:12.5px; color:var(--ink-2); margin-top:12px;">
      Cách nhanh nhất là mở camera điện thoại quét thẳng mã giấy trung tâm đưa.
      Mất mã thì liên hệ trung tâm để cấp lại — mã cũ bị thu hồi ngay.
    </p>
  <% end %>
</div>
