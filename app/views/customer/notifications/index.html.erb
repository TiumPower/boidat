<% content_for :title, "Thông báo" %>
<% content_for :tab, "notifications" %>
<div class="l-screen" style="padding-bottom:100px;">
  <header style="padding:18px 18px 12px; display:flex; justify-content:space-between; align-items:center;">
    <div style="font-family:var(--font-display); font-size:20px; font-weight:700;">Thông báo</div>
    <%= button_to "Đánh dấu đã đọc", member_read_all_notifications_path,
          class: "l-chip", style: "border:none; cursor:pointer;" %>
  </header>

  <div style="padding:0 18px;">
    <% @notifications.each do |n| %>
      <div class="l-panel" style="margin-bottom:10px; <%= 'border-color:var(--primary);' if n.awaiting_ack? %>">
        <div style="display:flex; gap:10px;">
          <div style="font-size:20px;"><%= n.display_icon %></div>
          <div style="flex:1; min-width:0;">
            <div style="display:flex; justify-content:space-between; gap:8px; align-items:baseline;">
              <div style="font-weight:700; font-size:14px;"><%= n.title %></div>
              <div style="font-size:11.5px; color:var(--ink-2); white-space:nowrap;">
                <%= l(n.created_at, format: "%H:%M") %>
              </div>
            </div>
            <p style="font-size:13px; color:var(--ink-2); margin:5px 0 0; line-height:1.5;"><%= n.body %></p>

            <% if n.awaiting_ack? %>
              <div style="display:flex; gap:8px; margin-top:10px; flex-wrap:wrap;">
                <%= button_to "Nghỉ theo thầy", member_ack_notification_path(n, choice: "follow_teacher"),
                      class: "l-btn l-btn-primary", style: "padding:7px 14px; font-size:12.5px;" %>
                <%= button_to "Chọn lịch khác", member_ack_notification_path(n, choice: "other_slot"),
                      class: "l-btn l-btn-soft", style: "padding:7px 14px; font-size:12.5px;" %>
              </div>
            <% elsif n.acknowledged? %>
              <span class="l-chip l-chip-brand" style="margin-top:8px;">Đã xác nhận</span>
            <% elsif n.deep_link.present? %>
              <%= link_to "Xem →", n.deep_link, style: "font-size:12.5px; color:var(--primary); font-weight:600; display:inline-block; margin-top:8px;" %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <% if @notifications.empty? %>
      <div class="l-panel" style="text-align:center; padding:28px;">
        <div style="font-size:30px;">🔔</div>
        <div style="font-weight:700; margin-top:8px;">Chưa có thông báo nào</div>
      </div>
    <% end %>

    <p style="font-size:12px; color:var(--ink-2); margin-top:14px; text-align:center;">
      Thông báo đẩy qua Web Push · trên iPhone cần thêm ứng dụng vào màn hình chính
    </p>
  </div>
</div>
