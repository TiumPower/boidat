<%# Host trần (boidat.tiumpower.com): không có trang giới thiệu, chỉ là bảng chọn cổng.
    Mọi chuỗi đi qua t() để nút VI/EN không để lại nửa trang tiếng Việt. %>
<% content_for :title, "BƠI ĐẠT" %>

<header class="k-head">
  <img src="/icon.svg" alt="" class="k-mark" width="52" height="52">
  <div>
    <div class="l-eyebrow">BƠI ĐẠT</div>
    <h1 style="font-family:var(--font-display); font-size:28px; margin:2px 0 4px;">
      <%= t("launcher.title") %>
    </h1>
    <p style="color:var(--ink-2); font-size:14px; margin:0; max-width:52ch;">
      <%= t("launcher.subtitle") %>
    </p>
  </div>
  <span class="k-lang">
    <%= link_to "VI", set_locale_path(:vi), class: ("on" if I18n.locale == :vi), data: { turbo: false } %>
    <%= link_to "EN", set_locale_path(:en), class: ("on" if I18n.locale == :en), data: { turbo: false } %>
  </span>
</header>

<div class="l-eyebrow" style="margin-bottom:10px;"><%= t("launcher.staff_group") %></div>
<div class="k-grid">
  <% [
       [:bod,     merchant_bod_root_path],
       [:ops,     merchant_ops_root_path],
       [:desk,    desk_root_path],
       [:teacher, teacher_root_path],
       [:admin,   admin_root_path]
     ].each do |key, path| %>
    <a class="k-card" href="<%= path %>">
      <div class="t"><%= t("launcher.#{key}") %></div>
      <div class="s"><%= t("launcher.#{key}_sub") %></div>
      <div class="u"><%= path %></div>
    </a>
  <% end %>
</div>

<p style="font-size:12.5px; color:var(--ink-2); margin:14px 2px 0;">
  <%= t("launcher.login_note", path: new_user_session_path) %>
</p>

<div class="l-eyebrow" style="margin:30px 0 10px;"><%= t("launcher.parent_group") %></div>
<div class="k-grid">
  <% @workspaces.each do |ws| %>
    <a class="k-card parent" href="/w/<%= ws.slug %>">
      <div class="t"><%= ws.name %></div>
      <div class="s"><%= t("launcher.parent_sub") %></div>
      <div class="u">/w/<%= ws.slug %></div>
    </a>
  <% end %>
  <% if @workspaces.empty? %>
    <p style="font-size:13.5px; color:var(--ink-2);"><%= t("launcher.no_workspace") %></p>
  <% end %>
</div>
