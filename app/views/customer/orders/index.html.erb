<% content_for :title, "Hoá đơn" %>
<% content_for :tab, "invoices" %>
<div class="l-screen" style="padding-bottom:100px;">
  <header style="padding:18px 18px 12px;">
    <div style="font-family:var(--font-display); font-size:20px; font-weight:700;">
      <%= current_household.individual? ? "Hoá đơn của tôi" : "Hoá đơn của gia đình" %>
    </div>
  </header>

  <div style="padding:0 18px;">
    <% @unpaid.each do |order| %>
      <div class="l-panel" style="margin-bottom:10px; border-color:var(--primary);">
        <div style="display:flex; gap:10px; justify-content:space-between; align-items:baseline;">
          <div style="flex:1; min-width:0;">
            <div style="font-weight:700; font-size:14.5px;"><%= order.package&.name || order.kind_label %></div>
            <div style="font-size:12.5px; color:var(--ink-2);">
              <%= order.student&.name %> · <%= order.code %>
            </div>
          </div>
          <div style="text-align:right; flex:none;">
            <div style="font-weight:700; font-size:17px; white-space:nowrap;"><%= vnd(order.total) %></div>
            <span class="l-chip" style="white-space:nowrap;"><%= order.status_label %></span>
          </div>
        </div>
        <%= button_to "Thanh toán bằng mã QR PayOS", member_pay_order_path(id: order.id),
              class: "l-btn l-btn-primary l-btn-block", style: "margin-top:12px;",
              form: { data: { turbo: false } } %>
      </div>
    <% end %>

    <div class="l-eyebrow" style="margin:18px 0 8px;">Lịch sử thanh toán</div>
    <div class="l-panel">
      <% @orders.each do |order| %>
        <%= link_to member_order_path(id: order.id),
              style: "display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid var(--line); text-decoration:none; color:inherit;" do %>
          <div>
            <div style="font-weight:600; font-size:13.5px;"><%= order.package&.name || order.kind_label %></div>
            <div style="font-size:12px; color:var(--ink-2);">
              <%= l(order.created_at.to_date, format: "%d/%m/%Y") %> ·
              <%= order.paid? ? (order.payments.first&.method_label || "PayOS") : "chưa thanh toán" %>
            </div>
          </div>
          <div style="text-align:right;">
            <div style="font-weight:600; font-size:13.5px;"><%= vnd(order.total) %></div>
            <span class="l-chip <%= 'l-chip-brand' if order.paid? %>"><%= order.status_label %></span>
          </div>
        <% end %>
      <% end %>
      <% if @orders.empty? %>
        <p style="font-size:13.5px; color:var(--ink-2);">Chưa có hoá đơn nào.</p>
      <% end %>
    </div>
  </div>
</div>
