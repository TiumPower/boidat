<% content_for :title, "Hoá đơn #{@order.code}" %>
<% content_for :tab, "invoices" %>
<div class="l-screen" style="padding-bottom:100px;">
  <header style="padding:16px 18px 12px;">
    <%= link_to "← Hoá đơn", member_orders_path, style: "font-size:13px; color:var(--ink-2); text-decoration:none;" %>
    <div style="font-family:var(--font-display); font-size:20px; font-weight:700; margin-top:8px;">
      <%= @order.package&.name || @order.kind_label %>
    </div>
    <div style="font-size:13px; color:var(--ink-2);"><%= @order.code %> · <%= @order.student&.name %></div>
  </header>

  <div style="padding:0 18px;">
    <div class="l-panel" style="text-align:center;">
      <div class="l-eyebrow">Số tiền</div>
      <div style="font-family:var(--font-display); font-size:30px; font-weight:700; color:var(--primary);">
        <%= vnd(@order.total) %>
      </div>
      <span class="l-chip <%= 'l-chip-brand' if @order.paid? %>" style="margin-top:8px;"><%= @order.status_label %></span>
      <% if @order.paid? && @order.paid_at %>
        <div style="font-size:12.5px; color:var(--ink-2); margin-top:8px;">
          Thanh toán lúc <%= l(@order.paid_at, format: "%H:%M %d/%m/%Y") %>
        </div>
      <% end %>
    </div>

    <% if @order.unpaid? %>
      <%= button_to "Thanh toán bằng mã QR PayOS", member_pay_order_path(@order),
            class: "l-btn l-btn-primary l-btn-block", style: "margin-top:14px;",
            form: { data: { turbo: false } } %>
      <p style="font-size:12.5px; color:var(--ink-2); margin-top:10px; text-align:center;">
        Quét mã bằng app ngân hàng. Trạng thái tự cập nhật khi PayOS báo về —
        nếu đã chuyển khoản mà chưa thấy đổi, hãy mở lại trang này sau ít phút.
      </p>
    <% end %>
  </div>
</div>
